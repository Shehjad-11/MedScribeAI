# ==============================================================================
# MedScribeAI Environment Configuration Example
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Gemini Cloud AI API Key (Server-Isolated — Never Exposed to Browser)
# Get a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# Clinician Authentication (DEMO ACCOUNT ONLY)
# Configure credentials for clinician workstation login.
CLINICIAN_USER="doctor"
CLINICIAN_PASS="medscribe2026"

# Document Encryption at Rest (AES-256-GCM)
# 32-byte secret key for encrypting patient documents in SQLite.
DOC_ENCRYPTION_KEY="medscribe-demo-master-key-32b!!"

# Privacy & Offline Mode Control
# Set to 'true' to completely block all outbound Cloud AI calls from kiosks
LOCAL_ONLY_MODE="false"

# Bhashini Indic Speech Recognition API (Optional - Leave blank to use Mock/WebSpeech)
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
